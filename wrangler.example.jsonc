// rag-demo-llamaindex — a Worker in front of a Python container running LlamaIndex.
//
// TEMPLATE. Copy it to wrangler.jsonc (git-ignored) and fill in your own IDs:
//   cp wrangler.example.jsonc wrangler.jsonc
// Then replace every <YOUR_SECRETS_STORE_ID> (dashboard: Secrets Store, or
// `npx wrangler secrets-store store list --remote`).
// Docs: https://developers.cloudflare.com/containers/
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "rag-demo-llamaindex",
	// Optional: pin your account so a command run from another login fails instead
	// of deploying elsewhere (`npx wrangler whoami` shows the ID).
	// "account_id": "<YOUR_ACCOUNT_ID>",
	"main": "src/index.js",
	// Cannot be newer than the workerd bundled with the installed wrangler.
	"compatibility_date": "2026-09-15",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// No public URL of any kind: the only caller is hubworld, through a service
	// binding. No routes and no custom domains either.
	"workers_dev": false,
	"preview_urls": false,

	"vars": {
		// An OpenAI chat model with tool calling. Also change the default in
		// container/app/settings.py, which local development uses (uvicorn does not
		// read this file); a mismatch shows up as 403 "model not allowed".
		"LLM_MODEL": "gpt-4o-mini",
		// Multilingual, 1024 dimensions — must match the Vectorize index. Changing it
		// means re-indexing every document (the originals are kept in R2 for that).
		"EMBED_MODEL": "@cf/baai/bge-m3",
		// AI Gateway every model call goes through (src/resources.js). Created on the
		// dashboard (AI → AI Gateway); its logs, cost analytics and rate limit belong to
		// this demo alone. Reached through the AI binding, so no gateway token is needed.
		"AI_GATEWAY_ID": "rag-demo-llamaindex"
	},

	// Bindings used by the resource provider (src/resources.js) on behalf of the container.
	"ai": { "binding": "AI", "remote": true },
	"vectorize": [{ "binding": "VECTORIZE", "index_name": "rag-demo-llamaindex", "remote": true }],
	"r2_buckets": [{ "binding": "DOCS", "bucket_name": "rag-demo-llamaindex-docs", "remote": true }],
	// From the account's shared Secrets Store. Read with `await env.X.get()`.
	// `wrangler dev` cannot read the production store; it uses a local one kept in
	// this project's .wrangler/state. Fill it once, from this folder (wrangler
	// prompts for the value):
	//   npx wrangler secrets-store secret create <YOUR_SECRETS_STORE_ID> --name OPENAI_TOKEN --scopes workers
	"secrets_store_secrets": [
		{ "binding": "OPENAI_API_KEY", "store_id": "<YOUR_SECRETS_STORE_ID>", "secret_name": "OPENAI_TOKEN" },
		{ "binding": "HUB_TOKEN", "store_id": "<YOUR_SECRETS_STORE_ID>", "secret_name": "HUB_TOKEN" }
	],

	// Three blocks make a container, and they must agree on one class name:
	//
	//   containers      -> which image to run, how big, how many at most
	//   durable_objects -> the binding the Worker calls (env.RAG_CONTAINER)
	//   exports         -> registers RagContainer as a SQLite-backed Durable Object
	//
	// One environment only (no `env` blocks): the hub binds to a single Worker name.
	"containers": [
		{
			// Explicit, so the application name never depends on the Worker name.
			"name": "rag-demo-llamaindex",
			"class_name": "RagContainer",
			// wrangler runs `docker build` on this file at deploy time.
			"image": "./container/Dockerfile",
			"image_build_context": "./container",
			// 1/4 vCPU, 1 GiB: "lite" (256 MiB) is too small to import LlamaIndex.
			"instance_type": "basic",
			// Hard cap on cost.
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "RAG_CONTAINER", "class_name": "RagContainer" }]
	},
	"exports": {
		"RagContainer": { "type": "durable-object", "storage": "sqlite" }
	},

	// Windows cannot run containers under `wrangler dev`; locally the Worker only
	// serves the resource provider (see LOCAL_RESOURCES in src/index.js) and FastAPI runs on uvicorn.
	"dev": {
		"enable_containers": false
	}
}
